{
  "name": "epoc",
  "version": "0.1.0",
  "description": "epoc (Epoch Context) — Epoch-paged, prefix-cache-first context engine for long-horizon coding agents (formerly prototyped as CPAT).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "tui": "node src/cli.ts tui",
    "demo": "node src/cli.ts run --demo",
    "bench": "node bench/deepresearch.ts",
    "bench:harness": "node bench/harness-suite.ts",
    "bench:public": "node bench/public-bench.ts",
    "bench:pi": "node bench/pi-billion-bench.ts",
    "bench:pi-120": "node bench/pi-scale2-bench.ts",
    "test": "node --test test/*.test.ts bench/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-cpat.ts"
    ]
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "blessed": "^0.1.81"
  }
}
